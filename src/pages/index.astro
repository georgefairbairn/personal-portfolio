---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.tsx";
import { CardGroup } from "../components/CardGroup";
---

<Layout title="George Fairbairn – Portfolio">
	<!-- Hero Section -->
	<div class="flex flex-col items-center justify-center h-dvh relative snap-start">
		<Hero client:load />
	</div>

	<!-- Career Section -->
	<section id="career" class="h-dvh snap-start px-6">
		<div class="max-w-6xl mx-auto h-full flex flex-col items-center justify-center gap-4 md:gap-5 py-4">
			<div class="flex items-center justify-center overflow-visible w-full">
				<CardGroup 
					cards={[
						{
							id: "octopus",
							image: "https://res.cloudinary.com/neon-flights/image/upload/c_limit,w_300/f_auto,q_auto/v1753733604/personal-website/octopus_orupdn.webp",
							alt: "Octopus",
							rotate: 7,
							hoverText: "Octopus Energy",
							backTitle: "Operations Manager",
							backSubtitle: "2016 - 2018"
						},
						{
							id: "color",
							image: "https://res.cloudinary.com/neon-flights/image/upload/c_limit,w_300/f_auto,q_auto/v1753733604/personal-website/color_logo_transparent_k3st7h.png",
							alt: "Color Logo",
							rotate: -13,
							hoverText: "Trinitatum",
							backTitle: "QA Engineer",
							backSubtitle: "2018 - 2019"
						},
						{
							id: "convergence",
							image: "https://res.cloudinary.com/neon-flights/image/upload/c_limit,w_300/f_auto,q_auto/v1753733604/personal-website/convergence_concepts_inc_logo_wexx9k.jpg",
							alt: "Convergence Concepts Inc Logo",
							rotate: 19,
							hoverText: "Convergence Concepts",
							backTitle: "Full Stack Software Engineer",
							backSubtitle: "2019 - 2020"
						},
						{
							id: "slack",
							image: "https://res.cloudinary.com/neon-flights/image/upload/c_limit,w_300/f_auto,q_auto/v1753733604/personal-website/slack_logo_vjzot8.png",
							alt: "Slack Logo",
							hoverText: "Slack",
							backTitle: "Senior Frontend Engineer",
							backSubtitle: "2020 - Present"
						}
					]}
					client:load
				/>
			</div>
			<h2 class="text-4xl md:text-[56px] font-heading text-center">CAREER</h2>
		</div>
	</section>

	<!-- Projects Section -->
	<section id="projects" class="h-dvh snap-start px-6 bg-opacity-10" style="background-color: var(--theme-accent-1);">
		<div class="max-w-6xl mx-auto h-full flex flex-col items-center justify-center gap-4 md:gap-5 py-4">
			<div class="flex items-center justify-center overflow-visible w-full">
				<CardGroup 
					cards={[
						{
							id: "bambino",
							image: "/projects/bambino.png",
							alt: "Bambino app icon",
							hoverText: "Bambino",
							href: "https://bambinobaby.xyz"
						}
					]}
					client:load
				/>
			</div>
			<h2 class="text-4xl md:text-[56px] font-heading text-center">PROJECTS</h2>
		</div>
	</section>
</Layout>
